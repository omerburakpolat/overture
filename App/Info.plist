<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE=YES);
	     only custom keys live here. -->

	<!-- Dock/Finder icon. App/ is a synchronized folder, so AppIcon.icns is
	     copied into Resources automatically; regenerate it with
	     scripts/make-icon.sh after editing Design/AppIcon.png. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>

	<!-- Sparkle: the release workflow uploads appcast.xml to every GitHub
	     release; /latest/download/ keeps the URL stable. -->
	<key>SUFeedURL</key>
	<string>https://github.com/omerburakpolat/overture/releases/latest/download/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- EdDSA public key for update signing; the private half lives in the
	     login keychain and the SPARKLE_ED_PRIVATE_KEY CI secret. -->
	<key>SUPublicEDKey</key>
	<string>sLbuExZ5DyeckyUfd35UsH0g8WS3SY4DVbFuguY+3p8=</string>

	<!-- Deep links from notifications (overture://card/<uuid>). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.overture.Overture</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>overture</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
